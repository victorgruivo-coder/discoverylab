# DiscoveryLab — production environment template.
#
# Copy this file, fill in real values, and keep the copy out of git:
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# `.env.prod` is ignored by the `.env.*` rule in .gitignore; this template is
# explicitly whitelisted so it can be committed.
#
# The database runs in the compose `db` service and is reachable only on the
# internal network at host `db`. To use a managed Postgres (Neon, Supabase)
# instead, point DATABASE_URL at it and remove the `db` service and volume
# from docker-compose.prod.yml.

# --- Postgres container -----------------------------------------------------
POSTGRES_USER=discoverylab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=discoverylab

# --- Edge / TLS -------------------------------------------------------------
# Comma-separated hostnames Caddy serves (replace 192.168.0.9 with this
# machine's LAN IP). Caddy uses its internal CA for localhost and private IPs,
# and a public ACME certificate for the domain. The public name's DNS must
# point at the server and ports 80/443 must be reachable for first issuance.
DOMAINS=localhost,192.168.0.9,discovery.vruivo.com.br

# Local HTTPS uses Caddy's internal CA; trust its root (in caddy_data) or
# accept the browser warning for localhost/LAN.

# --- API --------------------------------------------------------------------
# Must match POSTGRES_* above. Percent-encode special characters in the
# password (for example @ -> %40, : -> %3A). `db` is the compose service name.
DATABASE_URL=postgresql://discoverylab:change-me@db:5432/discoverylab?schema=public

# Comma-separated trusted browser origins (CORS). Mirror DOMAINS with a scheme;
# Caddy serves every entry over HTTPS, so use https://. Production cookies are
# Secure, so HTTP origins will not work. Trailing slashes are normalized.
WEB_ORIGINS=https://localhost,https://192.168.0.9,https://discovery.vruivo.com.br

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
