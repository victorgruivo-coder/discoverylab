DATABASE_URL="postgresql://discoverylab:discoverylab@localhost:5432/discoverylab?schema=public"

# Development defaults. Prod values come from the host:
#   PORT is the API listen port behind Nginx; Neon provides
#   DATABASE_URL with ?sslmode=require; WEB_ORIGIN is the public
#   origin (e.g. https://discoverylab.example.com).
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
