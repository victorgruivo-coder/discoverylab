DATABASE_URL="postgresql://discoverylab:discoverylab@localhost:5432/discoverylab?schema=public"

# Development defaults. Prod values come from the host:
#   PORT is the API listen port behind Caddy; DATABASE_URL points at
#   Postgres (managed URLs need ?sslmode=require); WEB_ORIGINS is a
#   comma-separated CORS allow-list, e.g.
#   https://localhost,https://discovery.vruivo.com.br.
NODE_ENV=development
PORT=3000
WEB_ORIGINS=http://localhost:5173
LOG_LEVEL=info
