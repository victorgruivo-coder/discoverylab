    "db:studio": "prisma studio",
    "verify:enums": "node scripts/verify-enums.mjs"
  },
  "dependencies": {
    "@discoverylab/shared": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "fastify": "5.12.5",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "tsx": "4.23.13"
  }
}
